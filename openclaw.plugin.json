{
  "id": "telegram-userbot",
  "name": "Telegram Userbot",
  "description": "Connect your personal Telegram account to OpenClaw via MTProto. Your AI assistant responds as you.",
  "version": "1.0.2",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channels": ["telegram-userbot"],
  "channelConfigs": {
    "telegram-userbot": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "allowFrom": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "groups": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "groupPolicy": {
                  "type": "string",
                  "enum": [
                    "open",
                    "mention"
                  ],
                  "default": "mention"
                },
                "allowReplyToSelf": {
                  "type": "boolean",
                  "default": false
                },
                "allowFrom": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                }
              }
            }
          },
          "accounts": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "apiId": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    }
                  ]
                },
                "apiHash": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "env": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "env"
                      ]
                    }
                  ]
                },
                "apiHashEnv": {
                  "type": "string"
                },
                "sessionString": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "env": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "env"
                      ]
                    }
                  ]
                },
                "sessionStringEnv": {
                  "type": "string"
                },
                "allowFrom": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                },
                "outbound": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "allowCurrentChat": {
                      "type": "boolean",
                      "default": true
                    },
                    "allowTo": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          }
                        ]
                      }
                    }
                  }
                },
                "media": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "default": false
                    },
                    "allowedRoots": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "allowRemoteUrls": {
                      "type": "boolean",
                      "default": false
                    },
                    "maxBytes": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    }
                  }
                },
                "groups": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "enabled": {
                        "type": "boolean"
                      },
                      "groupPolicy": {
                        "type": "string",
                        "enum": [
                          "open",
                          "mention"
                        ],
                        "default": "mention"
                      },
                      "allowReplyToSelf": {
                        "type": "boolean",
                        "default": false
                      },
                      "allowFrom": {
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "number"
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              },
              "required": [
                "apiId"
              ],
              "anyOf": [
                {
                  "required": [
                    "apiHash"
                  ]
                },
                {
                  "required": [
                    "apiHashEnv"
                  ]
                }
              ],
              "allOf": [
                {
                  "anyOf": [
                    {
                      "required": [
                        "sessionString"
                      ]
                    },
                    {
                      "required": [
                        "sessionStringEnv"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    }
  }
}
